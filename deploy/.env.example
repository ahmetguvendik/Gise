# Kopyalayıp doldurun:  cp deploy/.env.example deploy/.env
# .env repoya girmez. Parola üretmek için:  openssl rand -hex 16

POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
MINIO_ROOT_PASSWORD=
ELASTIC_PASSWORD=

# scripts/dev-users.sh ile oluşturulan yerel test kullanıcılarının parolası
DEV_USERS_PASSWORD=

# Keycloak'ın mailleri (e-posta doğrulama, şifre sıfırlama) Gmail SMTP ile gider.
# SMTP_USERNAME: Gmail adresi. SMTP_PASSWORD: Google "uygulama şifresi" (hesap parolası değil;
# Google Hesabı → Güvenlik → 2 Adımlı Doğrulama → Uygulama şifreleri). Tırnaksız yazın.
# Var olan kurulumda değiştirince:  ./deploy/scripts/keycloak-smtp.sh
SMTP_USERNAME=
SMTP_PASSWORD=
