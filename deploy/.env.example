# Kopyalayıp doldurun:  cp deploy/.env.example deploy/.env
# .env repoya girmez. Parola üretmek için:  openssl rand -hex 16

POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
MINIO_ROOT_PASSWORD=
ELASTIC_PASSWORD=

# Gözlemlenebilirlik (bkz. tasarım 8): Kibana'nın, Logstash'in ve APM Server'ın Elasticsearch hesapları; deploy/elasticsearch/setup.sh
# atar. KIBANA_ENCRYPTION_KEY en az 32 karakter ve sabit olmalı.  openssl rand -hex 32
KIBANA_PASSWORD=
KIBANA_ENCRYPTION_KEY=
LOGSTASH_PASSWORD=
APM_PASSWORD=

# APISIX yönetim API'si ve dashboard'u (http://127.0.0.1:9180/ui/) için anahtar. Üretmek için:  openssl rand -hex 32
APISIX_ADMIN_KEY=

# scripts/dev-users.sh ile oluşturulan yerel test kullanıcılarının parolası
DEV_USERS_PASSWORD=

# Keycloak'ın mailleri (e-posta doğrulama, şifre sıfırlama) Gmail SMTP ile gider.
# SMTP_USERNAME: Gmail adresi. SMTP_PASSWORD: Google "uygulama şifresi" (hesap parolası değil;
# Google Hesabı → Güvenlik → 2 Adımlı Doğrulama → Uygulama şifreleri). Tırnaksız yazın.
# Var olan kurulumda değiştirince:  ./deploy/scripts/keycloak-smtp.sh
SMTP_USERNAME=
SMTP_PASSWORD=

# Identity servislerinin Keycloak servis hesabı (gise-identity) için gizli anahtar; tek yetkisi Keycloak olaylarını
# okumak (view-events). Üretmek için:  openssl rand -hex 32
IDENTITY_CLIENT_SECRET=
