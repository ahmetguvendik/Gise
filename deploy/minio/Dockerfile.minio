# MinIO'nun Docker Hub'daki eski sürüm imajları kaldırıldı; aynı sürüm kaynaktan derlenir (linux/amd64, bkz. images.yml).
FROM golang:1.24-alpine AS build
ARG MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
RUN CGO_ENABLED=0 GOBIN=/out go install -trimpath github.com/minio/minio@${MINIO_VERSION}

FROM alpine:3.21
RUN apk add --no-cache ca-certificates curl && mkdir /data
COPY --from=build /out/minio /usr/bin/minio
EXPOSE 9000 9001
VOLUME /data
ENTRYPOINT ["/usr/bin/minio"]
