{
  "Logging": {
    "Kafka": {
      "BootstrapServers": "kafka:9092",
      "Topic": "logs.api",
      "AuditTopic": "logs.audit",
      "Partitions": 3,
      "RetentionHours": 24,
      "BatchSize": 500,
      "FlushSeconds": 2,
      "QueueLimit": 10000
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error",
        "LuckyPennySoftware": "Error",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Elastic.Apm": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Audience": "gise-api",
    "RequireHttpsMetadata": true,
    "AdminUrl": "http://keycloak:8080/auth/admin/realms/gise",
    "ServiceClientId": "gise-identity",
    "ServiceClientSecret": "",
    "RequestTimeoutSeconds": 5,
    "RolesClientId": "gise-identity-roles",
    "RolesClientSecret": ""
  }
}
