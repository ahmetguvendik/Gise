{
  "Logging": {
    "Kafka": {
      "BootstrapServers": "kafka:9092",
      "Topic": "logs.api",
      "AuditTopic": "logs.audit",
      "Partitions": 3,
      "RetentionHours": 24,
      "BatchSize": 500,
      "FlushSeconds": 2,
      "QueueLimit": 10000
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error",
        "LuckyPennySoftware": "Error",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Elastic.Apm": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Audience": "gise-api",
    "RequireHttpsMetadata": true
  },
  "HealthChecksUI": {
    "EvaluationSeconds": 30,
    "HealthChecks": [
      {
        "Name": "catalog-api",
        "Uri": "http://catalog-api:8080/health"
      },
      {
        "Name": "audit-api",
        "Uri": "http://audit-api:8080/health"
      },
      {
        "Name": "identity-api",
        "Uri": "http://identity-api:8080/health"
      },
      {
        "Name": "notification-api",
        "Uri": "http://notification-api:8080/health"
      },
      {
        "Name": "order-api",
        "Uri": "http://order-api:8080/health"
      },
      {
        "Name": "payment-api",
        "Uri": "http://payment-api:8080/health"
      },
      {
        "Name": "reservation-api",
        "Uri": "http://reservation-api:8080/health"
      },
      {
        "Name": "search-api",
        "Uri": "http://search-api:8080/health"
      },
      {
        "Name": "seatmap-api",
        "Uri": "http://seatmap-api:8080/health"
      },
      {
        "Name": "ticket-api",
        "Uri": "http://ticket-api:8080/health"
      },
      {
        "Name": "audit-log-worker",
        "Uri": "http://audit-log-worker:8080/health"
      },
      {
        "Name": "catalog-outbox-worker",
        "Uri": "http://catalog-outbox-worker:8080/health"
      },
      {
        "Name": "identity-audit-worker",
        "Uri": "http://identity-audit-worker:8080/health"
      },
      {
        "Name": "notification-inbox-worker",
        "Uri": "http://notification-inbox-worker:8080/health"
      },
      {
        "Name": "order-inbox-worker",
        "Uri": "http://order-inbox-worker:8080/health"
      },
      {
        "Name": "order-saga-worker",
        "Uri": "http://order-saga-worker:8080/health"
      },
      {
        "Name": "payment-command-worker",
        "Uri": "http://payment-command-worker:8080/health"
      },
      {
        "Name": "reservation-command-worker",
        "Uri": "http://reservation-command-worker:8080/health"
      },
      {
        "Name": "reservation-inbox-worker",
        "Uri": "http://reservation-inbox-worker:8080/health"
      },
      {
        "Name": "search-sync-worker",
        "Uri": "http://search-sync-worker:8080/health"
      },
      {
        "Name": "ticket-command-worker",
        "Uri": "http://ticket-command-worker:8080/health"
      },
      {
        "Name": "ticket-inbox-worker",
        "Uri": "http://ticket-inbox-worker:8080/health"
      },
      {
        "Name": "ticket-outbox-worker",
        "Uri": "http://ticket-outbox-worker:8080/health"
      },
      {
        "Name": "altyapi",
        "Uri": "http://healthcheck-api:8080/health/infrastructure"
      },
      {
        "Name": "hata-orani",
        "Uri": "http://healthcheck-api:8080/health/error-rate"
      }
    ],
    "Webhooks": []
  },
  "Infrastructure": {
    "TimeoutSeconds": 3,
    "Targets": [
      {
        "Name": "postgres",
        "Type": "tcp",
        "Address": "postgres:5432"
      },
      {
        "Name": "kafka",
        "Type": "tcp",
        "Address": "kafka:9092"
      },
      {
        "Name": "rabbitmq",
        "Type": "tcp",
        "Address": "rabbitmq:5672"
      },
      {
        "Name": "redis",
        "Type": "tcp",
        "Address": "redis:6379"
      },
      {
        "Name": "minio",
        "Type": "http",
        "Address": "http://minio:9000/minio/health/live"
      },
      {
        "Name": "keycloak",
        "Type": "http",
        "Address": "http://keycloak:9000/health/ready"
      },
      {
        "Name": "apisix",
        "Type": "http",
        "Address": "http://apisix:8000/gateway-health"
      },
      {
        "Name": "etcd",
        "Type": "http",
        "Address": "http://etcd:2379/health"
      },
      {
        "Name": "istemci",
        "Type": "http",
        "Address": "http://client:80/"
      },
      {
        "Name": "elasticsearch",
        "Type": "elasticsearch",
        "Address": "http://elasticsearch:9200"
      },
      {
        "Name": "logstash",
        "Type": "http",
        "Address": "http://logstash:9600/_node/pipelines",
        "Vital": false
      },
      {
        "Name": "kibana",
        "Type": "http",
        "Address": "http://kibana:5601/api/status",
        "AcceptedStatuses": [
          200,
          401
        ],
        "Vital": false
      },
      {
        "Name": "apm-server",
        "Type": "http",
        "Address": "http://apm-server:8200/",
        "Vital": false
      }
    ]
  },
  "Elasticsearch": {
    "Url": "http://elasticsearch:9200",
    "Username": "health_reader",
    "Password": ""
  },
  "Alerting": {
    "ErrorRate": {
      "IndexPattern": "logs-gise.api-*,logs-gise.workers-*",
      "WindowMinutes": 5,
      "Threshold": 10
    },
    "Environment": "Development",
    "PanelUrl": "http://localhost:9095",
    "LogsUrl": "http://localhost:5601/app/discover",
    "Slack": {
      "WebhookUrl": ""
    }
  }
}
