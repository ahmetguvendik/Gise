{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Quartz": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Audience": "gise-api",
    "RequireHttpsMetadata": true
  },
  "Catalog": {
    "GrpcUrl": "http://catalog-api:8081",
    "GrpcTimeoutSeconds": 5
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Username": "gise",
    "Password": ""
  },
  "OrderRules": {
    "PaymentWindowMinutes": 10,
    "MaxSeatsPerOrder": 10
  }
}
