{
  "Logging": {
    "Kafka": {
      "BootstrapServers": "kafka:9092",
      "Topic": "logs.api",
      "AuditTopic": "logs.audit",
      "Partitions": 3,
      "RetentionHours": 24,
      "BatchSize": 500,
      "FlushSeconds": 2,
      "QueueLimit": 10000
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error",
        "MassTransit": "Warning",
        "LuckyPennySoftware": "Error",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Elastic.Apm": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Quartz": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Audience": "gise-api",
    "RequireHttpsMetadata": true
  },
  "Catalog": {
    "GrpcUrl": "http://catalog-api:8081",
    "GrpcTimeoutSeconds": 5
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Username": "gise",
    "Password": ""
  },
  "OrderRules": {
    "PaymentWindowMinutes": 10,
    "MaxSeatsPerOrder": 5
  }
}
