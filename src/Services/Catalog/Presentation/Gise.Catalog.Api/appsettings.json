{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://+:8080", "Protocols": "Http1" },
      "Grpc": { "Url": "http://+:8081", "Protocols": "Http2" }
    }
  },
  "Keycloak": {
    "Audience": "gise-api",
    "RequireHttpsMetadata": true
  },
  "Storage": {
    "Endpoint": "http://minio:9000",
    "PublicEndpoint": "http://localhost:9000",
    "Bucket": "gise-media",
    "AccessKey": "",
    "SecretKey": "",
    "UploadUrlTtlSeconds": 300,
    "MaxUploadSizeMb": 5,
    "MaxImageMegapixels": 40,
    "VariantWidths": [ 400, 800, 1200 ],
    "DefaultVariantWidth": 800
  },
  "CatalogRules": {
    "VenueNameMaxLength": 200,
    "CityMaxLength": 100,
    "SectionNameMaxLength": 100,
    "RowNameMaxLength": 10,
    "MaxSeatsPerRow": 100,
    "MaxSeatsPerVenue": 5000,
    "EventTitleMaxLength": 200,
    "CancellationReasonMaxLength": 500,
    "ReturnReasonMaxLength": 500,
    "MaxPrice": 1000000
  }
}
