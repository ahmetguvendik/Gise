{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://+:8080", "Protocols": "Http1" },
      "Grpc": { "Url": "http://+:8081", "Protocols": "Http2" }
    }
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "TopicPartitions": 3,
    "TopicReplicationFactor": 1
  },
  "Outbox": {
    "BatchSize": 50,
    "PollIntervalSeconds": 2,
    "MaxRetryCount": 10,
    "ProduceTimeoutSeconds": 10,
    "RetentionDays": 7,
    "CleanupIntervalMinutes": 60
  },
  "Keycloak": {
    "Audience": "gise-api",
    "RequireHttpsMetadata": true
  },
  "CatalogRules": {
    "VenueNameMaxLength": 200,
    "CityMaxLength": 100,
    "SectionNameMaxLength": 100,
    "RowNameMaxLength": 10,
    "MaxSeatsPerRow": 100,
    "MaxSeatsPerVenue": 5000,
    "EventTitleMaxLength": 200,
    "MaxPrice": 1000000
  }
}
