{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "filter": {
        "tr_lowercase": {
          "type": "lowercase",
          "language": "turkish"
        },
        "tr_stop": {
          "type": "stop",
          "stopwords": "_turkish_"
        },
        "tr_stemmer": {
          "type": "stemmer",
          "language": "turkish"
        },
        "prefix_edge": {
          "type": "edge_ngram",
          "min_gram": 1,
          "max_gram": 20
        }
      },
      "analyzer": {
        "tr_text": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "apostrophe",
            "tr_lowercase",
            "tr_stop",
            "tr_stemmer",
            "asciifolding"
          ]
        },
        "tr_folded": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "apostrophe",
            "tr_lowercase",
            "asciifolding"
          ]
        },
        "tr_prefix": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "apostrophe",
            "tr_lowercase",
            "asciifolding",
            "prefix_edge"
          ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id": {
        "type": "keyword"
      },
      "venueId": {
        "type": "keyword"
      },
      "title": {
        "type": "text",
        "analyzer": "tr_text",
        "fields": {
          "suggest": {
            "type": "text",
            "analyzer": "tr_prefix",
            "search_analyzer": "tr_folded"
          }
        }
      },
      "venueName": {
        "type": "text",
        "analyzer": "tr_text",
        "fields": {
          "keyword": {
            "type": "keyword"
          },
          "suggest": {
            "type": "text",
            "analyzer": "tr_prefix",
            "search_analyzer": "tr_folded"
          }
        }
      },
      "city": {
        "type": "text",
        "analyzer": "tr_text",
        "fields": {
          "keyword": {
            "type": "keyword"
          },
          "suggest": {
            "type": "text",
            "analyzer": "tr_prefix",
            "search_analyzer": "tr_folded"
          }
        }
      },
      "startsAt": {
        "type": "date"
      },
      "minPrice": {
        "type": "scaled_float",
        "scaling_factor": 100
      },
      "posterKey": {
        "type": "keyword",
        "index": false
      },
      "seatCount": {
        "type": "integer"
      },
      "availableCount": {
        "type": "integer"
      }
    }
  }
}
