{
  "Logging": {
    "Kafka": {
      "BootstrapServers": "kafka:9092",
      "Topic": "logs",
      "Partitions": 3,
      "RetentionHours": 24,
      "BatchSize": 500,
      "FlushSeconds": 2,
      "QueueLimit": 10000
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error",
        "LuckyPennySoftware": "Error",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Elastic.Apm": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Elasticsearch": {
    "Url": "http://elasticsearch:9200",
    "Username": "elastic",
    "Password": "",
    "RequestTimeoutSeconds": 5
  },
  "Availability": {
    "FewLeftThreshold": 20
  },
  "Posters": {
    "PublicBaseUrl": "http://localhost:9000/gise-media",
    "VariantWidths": [ 400, 800, 1200 ],
    "DefaultVariantWidth": 800
  }
}
