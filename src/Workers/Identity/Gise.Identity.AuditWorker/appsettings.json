{
  "Logging": {
    "Kafka": {
      "BootstrapServers": "kafka:9092",
      "Topic": "logs.workers",
      "AuditTopic": "logs.audit",
      "Partitions": 3,
      "RetentionHours": 24,
      "BatchSize": 500,
      "FlushSeconds": 2,
      "QueueLimit": 10000
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Elastic.Apm": "Warning"
      }
    }
  },
  "Keycloak": {
    "InternalAuthority": "http://keycloak:8080/auth/realms/gise",
    "AdminUrl": "http://keycloak:8080/auth/admin/realms/gise",
    "ServiceClientId": "gise-identity",
    "ServiceClientSecret": "",
    "RequestTimeoutSeconds": 10
  },
  "EventSync": {
    "IntervalSeconds": 30,
    "RetryDelaySeconds": 30
  }
}
