{
  "Logging": {
    "Kafka": {
      "BootstrapServers": "kafka:9092",
      "Topic": "logs.workers",
      "AuditTopic": "logs.audit",
      "Partitions": 3,
      "RetentionHours": 24,
      "BatchSize": 500,
      "FlushSeconds": 2,
      "QueueLimit": 10000
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Elastic.Apm": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Audit": "Host=postgres;Database=gise_audit;Username=gise;Password="
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "Topic": "logs.audit",
    "ConsumerGroup": "audit-log-worker",
    "BatchSize": 100,
    "ErrorBackoffSeconds": 3
  },
  "Retention": {
    "Days": 730,
    "CleanupIntervalHours": 24
  },
  "Health": {
    "StaleAfterSeconds": 60
  }
}
