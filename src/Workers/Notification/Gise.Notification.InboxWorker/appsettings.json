{
  "Logging": {
    "Kafka": {
      "BootstrapServers": "kafka:9092",
      "Topic": "logs",
      "Partitions": 3,
      "RetentionHours": 24,
      "BatchSize": 500,
      "FlushSeconds": 2,
      "QueueLimit": 10000
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Elastic.Apm": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "ConsumerGroups": {
      "Catalog": "notification-inbox-worker-catalog",
      "Ticket": "notification-inbox-worker-ticket"
    },
    "ErrorBackoffSeconds": 3
  },
  "Inbox": {
    "BatchSize": 50,
    "PollIntervalSeconds": 2,
    "MaxRetryCount": 10,
    "RetentionDays": 7,
    "CleanupIntervalMinutes": 60
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromName": "Gişe",
    "EnableSsl": true
  },
  "Notification": {
    "WebBaseUrl": "http://localhost:8000",
    "TimeZone": "Europe/Istanbul"
  }
}
