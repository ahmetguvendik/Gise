{
  "Logging": {
    "Kafka": {
      "BootstrapServers": "kafka:9092",
      "Topic": "logs.workers",
      "AuditTopic": "logs.audit",
      "Partitions": 3,
      "RetentionHours": 24,
      "BatchSize": 500,
      "FlushSeconds": 2,
      "QueueLimit": 10000
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Elastic.Apm": "Warning"
      }
    }
  },
  "Catalog": {
    "GrpcUrl": "http://catalog-api:8081",
    "GrpcTimeoutSeconds": 10
  },
  "Reservation": {
    "GrpcUrl": "http://reservation-api:8081"
  },
  "Elasticsearch": {
    "Url": "http://elasticsearch:9200",
    "Username": "elastic",
    "Password": "",
    "RequestTimeoutSeconds": 30
  },
  "Sync": {
    "IntervalSeconds": 60,
    "RetryDelaySeconds": 30
  }
}
