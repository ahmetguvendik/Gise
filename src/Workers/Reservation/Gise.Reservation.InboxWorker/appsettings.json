{
  "Logging": {
    "Kafka": {
      "BootstrapServers": "kafka:9092",
      "Topic": "logs.workers",
      "AuditTopic": "logs.audit",
      "Partitions": 3,
      "RetentionHours": 24,
      "BatchSize": 500,
      "FlushSeconds": 2,
      "QueueLimit": 10000
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Elastic.Apm": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "ConsumerGroup": "reservation-inbox-worker",
    "ErrorBackoffSeconds": 3
  },
  "Catalog": {
    "GrpcUrl": "http://catalog-api:8081",
    "GrpcTimeoutSeconds": 10
  },
  "Inbox": {
    "BatchSize": 50,
    "PollIntervalSeconds": 2,
    "MaxRetryCount": 10,
    "RetentionDays": 7,
    "CleanupIntervalMinutes": 60
  }
}
